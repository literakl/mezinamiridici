<div class="poll-results mb-4">
  <h4 class="mb-3" style="font-size: 18px; font-weight: 600; color: var(--text-color);">
    Výsledky hlasování ({{votes.total}} hlasů)
  </h4>

  <!-- V pohodě -->
  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <div class="d-flex align-items-center">
        <img src="/images/icons/happy.svg" alt="V pohodě" style="width: 24px; height: 24px; margin-right: 8px;" onerror="this.style.display='none'">
        <strong style="font-size: 15px;">V pohodě</strong>
      </div>
      <span style="font-size: 14px; font-weight: 600; color: var(--no-problem-status);">{{votes.neutral}} ({{votes.neutralPercent}}%)</span>
    </div>
    <div class="progress" style="height: 12px; border-radius: 6px; background-color: #e9ecef;">
      <div class="progress-bar" role="progressbar" style="width: {{votes.neutralPercent}}%; background-color: var(--no-problem-status);" aria-valuenow="{{votes.neutralPercent}}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
  </div>

  <!-- Mírné potíže -->
  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <div class="d-flex align-items-center">
        <img src="/images/icons/ok.svg" alt="Mírné potíže" style="width: 24px; height: 24px; margin-right: 8px;" onerror="this.style.display='none'">
        <strong style="font-size: 15px;">Mírné potíže</strong>
      </div>
      <span style="font-size: 14px; font-weight: 600; color: var(--traval-trouble-status);">{{votes.trivial}} ({{votes.trivialPercent}}%)</span>
    </div>
    <div class="progress" style="height: 12px; border-radius: 6px; background-color: #e9ecef;">
      <div class="progress-bar" role="progressbar" style="width: {{votes.trivialPercent}}%; background-color: var(--traval-trouble-status);" aria-valuenow="{{votes.trivialPercent}}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
  </div>

  <!-- Nelíbí se mi -->
  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <div class="d-flex align-items-center">
        <img src="/images/icons/dislike.svg" alt="Nelíbí se mi" style="width: 24px; height: 24px; margin-right: 8px;" onerror="this.style.display='none'">
        <strong style="font-size: 15px;">Nelíbí se mi</strong>
      </div>
      <span style="font-size: 14px; font-weight: 600; color: var(--dislike-status);">{{votes.dislike}} ({{votes.dislikePercent}}%)</span>
    </div>
    <div class="progress" style="height: 12px; border-radius: 6px; background-color: #e9ecef;">
      <div class="progress-bar" role="progressbar" style="width: {{votes.dislikePercent}}%; background-color: var(--dislike-status);" aria-valuenow="{{votes.dislikePercent}}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
  </div>

  <!-- Totální průšvih -->
  <div class="mb-3">
    <div class="d-flex justify-content-between align-items-center mb-1">
      <div class="d-flex align-items-center">
        <img src="/images/icons/angry.svg" alt="Totální průšvih" style="width: 24px; height: 24px; margin-right: 8px;" onerror="this.style.display='none'">
        <strong style="font-size: 15px;">Totální průšvih</strong>
      </div>
      <span style="font-size: 14px; font-weight: 600; color: var(--angry-status);">{{votes.hate}} ({{votes.hatePercent}}%)</span>
    </div>
    <div class="progress" style="height: 12px; border-radius: 6px; background-color: #e9ecef;">
      <div class="progress-bar" role="progressbar" style="width: {{votes.hatePercent}}%; background-color: var(--angry-status);" aria-valuenow="{{votes.hatePercent}}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
  </div>
</div>
