<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}} - Mezi námi řidiči</title>
  <meta name="description" content="{{pageDescription}}">
  <link rel="canonical" href="{{canonicalUrl}}">
  <meta property="og:type" content="article">
  <meta property="og:url" content="{{canonicalUrl}}">
  <meta property="og:site_name" content="Mezi námi řidiči">
  <meta property="og:title" content="{{pageTitle}}">
  <meta property="og:description" content="{{pageDescription}}">
  {{#if ogImage}}
  <meta property="og:image" content="{{ogImage}}">
  <meta name="twitter:card" content="summary_large_image">
  {{/if}}
  {{#if jsonLd}}
  <script type="application/ld+json">{{{jsonLd}}}</script>
  {{/if}}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&family=Amatic+SC:wght@700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/styles.css">

  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://www.mezinamiridici.cz/js/script.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>
<body style="background-color: var(--body-color);">
  {{> header}}

  <div class="container pt-4 pb-5" style="max-width: 900px;">
    <article class="bg-white p-4 mb-4" style="border-radius: 8px; box-shadow: var(--box-shadow);">
      <h1 class="mb-3" style="font-size: 28px; font-weight: 700; color: var(--text-color);">{{item.info.caption}}</h1>

      <div class="d-flex align-items-center mb-4 text-muted" style="font-size: 14px;">
        <span class="mr-3"><strong>{{item.info.author.nickname}}</strong></span>
        <span>{{formatDate item.info.date}}</span>
      </div>

      <div class="post-content" style="font-size: 16px; line-height: 1.7; color: var(--text-color);">
        {{{item.data.content}}}
      </div>

      {{#if item.snippets}}
        {{#each item.snippets}}
          <div class="snippet mt-3 p-3" style="background-color: #f8f9fa; border-radius: 4px; overflow-x: auto;">
            <pre style="margin: 0;"><code>{{{this.code}}}</code></pre>
          </div>
        {{/each}}
      {{/if}}
    </article>

    {{> comments-section comments=comments commentCount=commentCount}}

    {{#if otherArticles}}
      <div class="mb-4">
        <h2 class="mb-3" style="font-size: 20px; font-weight: 700; color: var(--text-color);">Další články</h2>
        <div class="row">
          {{#each otherArticles}}
            <div class="col-md-4 mb-4">
              {{> item-card item=this}}
            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}
  </div>

  {{> footer}}
</body>
</html>
